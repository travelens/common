---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Layout from './Layout.astro'
import Header from './Header.astro'
import Tags from './Tags.astro'
import Footer from './Footer.astro'
import { slugify } from './utils'

interface Props {
  post: CollectionEntry<'post'>
}

const { post } = Astro.props
---

<Layout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  image={post.data.image}
  tags={post.data.tags}
>
  <Header />
  <div
    class="bg-rosely-black flex w-full items-center justify-center relative overflow-hidden -mt-24"
  >
    <div class="h-96 relative">
      <Image src={post.data.image} class="opacity-60 w-full object-cover" alt={post.data.title} />
    </div>
  </div>
  <div class="mx-auto px-12 pt-12 bg-rosely-sugar max-w-4xl relative z-10 -mt-32 lg:px-24">
    <a href={`${import.meta.env.BASE_URL}`}>
      <p
        class="text-xs text-rosely-granite tracking-widest mt-4 uppercase hover:text-rosely-morning"
      >
        {post.data.trip}
      </p>
    </a>
    <div class="text-rosely-granite my-2 flex items-center">
      <a href={'/place/' + slugify(post.data.place)} class="hover:text-rosely-morning">
        <span class="i-fa6-solid-globe h-4 w-4" aria-hidden="true"></span>
        <span class="ml-1">{post.data.place}</span>
      </a>
      <span class="i-fa6-solid-angles-right mx-4 h-4 w-4" aria-hidden="true"></span>
      <span class="i-fa6-solid-location-arrow h-4 w-4" aria-hidden="true"></span>
      <span class="ml-1">{post.data.location}</span>
    </div>
    <h1 class="text-2xl text-rosely-black font-display mt-4 md:text-3xl">
      {post.data.title}
    </h1>
    <Tags tags={post.data.tags} />
    <div class="text-rosely-granite my-2 flex items-center">
      <span class="i-fa6-solid-calendar-days h-6 w-6" aria-hidden="true"></span>
      <span class="ml-1">
        {
          new Date(post.data.date).toLocaleString('en-AU', {
            dateStyle: 'full',
            timeStyle: 'long',
            timeZone: post.data.timezone
          })
        }
      </span>
    </div>

    <div class="mt-6 italic prose prose-sm sm:prose md:prose-base lg:prose-lg">
      {post.data.description}
    </div>
    <hr class="border-0 rounded-full bg-rosely-barely h-1 w-full" />
  </div>
  <slot />
  <Footer />
</Layout>
