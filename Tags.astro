---
export interface Props {
  tags?: string[]
}

const { tags } = Astro.props
---

{
  tags && (
    <div class="mt-2 flex flex-row flex-wrap gap-4 items-start lg:gap-2">
      {tags.map((tag) => (
        <a
          href={`/tag/${encodeURIComponent(tag)}/`}
          class="text-xs text-rosely-grapeade font-semibold px-2 py-2 rounded-md bg-rosely-heavenly inline-block hover:text-rosely-black lg:py-1 hover:bg-rosely-barely"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
