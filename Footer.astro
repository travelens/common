---
import { SiteMetadata, NavigationLinks, Websites } from './config'
---

<footer
  aria-label="Site footer"
  class="text-rosely-sugar border-t-2 border-rosely-morning bg-rosely-black"
>
  <div class="mx-auto px-8 py-16 container">
    <div class="gap-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a
          href="/"
          class="text-4xl text-rosely-sugar tracking-tight font-display transition-colors hover:text-rosely-morning"
        >
          travelens
        </a>
        <p class="text-xs text-rosely-opal leading-relaxed mt-3 italic">
          {SiteMetadata.description}
        </p>
      </div>

      <!-- Explore -->
      <div>
        <h3 class="text-xs text-rosely-morning tracking-widest font-semibold mb-5 uppercase">
          Explore
        </h3>
        <ul class="space-y-3">
          {
            NavigationLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-rosely-opal transition-colors hover:text-rosely-sugar"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Other Sites -->
      <div>
        <h3 class="text-xs text-rosely-morning tracking-widest font-semibold mb-5 uppercase">
          Also By
        </h3>
        <ul class="space-y-3">
          {
            Websites.map((site) => (
              <li>
                <a
                  href={site.link}
                  class="text-sm text-rosely-opal transition-colors hover:text-rosely-sugar"
                >
                  {site.website}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="text-xs text-rosely-morning tracking-widest font-semibold mb-5 uppercase">
          Connect
        </h3>
        <ul class="space-y-3">
          {
            SiteMetadata.social.map((link) => (
              <li>
                <a
                  href={link.link}
                  class="text-sm text-rosely-opal flex gap-2 transition-colors items-center hover:text-rosely-sugar"
                >
                  <span class={'w-4 h-4 i-fa6-brands-' + link.icon} aria-hidden="true" />
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="text-xs text-rosely-opal/60 tracking-widest mt-12 pt-8 border-t border-rosely-sugar/10 flex flex-col gap-4 items-center justify-between sm:flex-row"
    >
      <span>
        &copy;{new Date().getFullYear()}
        <a href="https://christham.net" class="ml-1 transition-colors hover:text-rosely-morning">
          {SiteMetadata.author.name}
        </a>
        &mdash; all rights reserved
      </span>
      <div class="flex gap-6 items-center">
        <a
          href="/rss.xml"
          class="tracking-widest uppercase transition-colors hover:text-rosely-morning">RSS</a
        >
        <a
          href="/sitemap.xml"
          class="tracking-widest uppercase transition-colors hover:text-rosely-morning">Sitemap</a
        >
      </div>
    </div>
  </div>
</footer>
