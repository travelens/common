---

---

<search-modal class="flex flex-1 items-center">
  <div class="flex w-full justify-center">
    <div class="w-64">
      <div class="flex w-full items-stretch relative">
        <input
          type="search"
          class="text-base text-rosely-granite font-medium m-0 px-3 py-1.5 border border-rosely-morning rounded border-solid bg-white flex-auto max-w-xs min-w-0 w-full block transition ease-in-out relative bg-clip-padding dark:text-rosely-opal focus:text-rosely-black focus:outline-none dark:border-rosely-orchid focus:border-rosely-orchid dark:bg-rosely-black dark:focus:text-rosely-sugar dark:focus:border-rosely-morning"
          id="search-box"
          name="q"
          maxlength="255"
          value=""
          placeholder="Search"
          aria-label="Search"
          aria-describedby="searchbutton"
        />
        <button
          class="text-xs text-white leading-tight font-medium px-2 py-2 rounded bg-rosely-orchid inline-block uppercase shadow-md transition duration-150 ease-in-out items-center focus:outline-none active:bg-rosely-grapeade dark:bg-rosely-orchid focus:bg-rosely-grapeade hover:bg-rosely-morning focus:ring-0 active:shadow-lg focus:shadow-lg hover:shadow-lg"
          type="button"
          name="search"
          id="search-button"
          aria-label="Search Button"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            data-prefix="fas"
            data-icon="search"
            class="h-4 w-4"
            role="img"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 512 512"
          >
            <path
              fill="currentColor"
              d="M505 442.7L405.3 343c-4.5-4.5-10.6-7-17-7H372c27.6-35.3 44-79.7 44-128C416 93.1 322.9 0 208 0S0 93.1 0 208s93.1 208 208 208c48.3 0 92.7-16.4 128-44v16.3c0 6.4 2.5 12.5 7 17l99.7 99.7c9.4 9.4 24.6 9.4 33.9 0l28.3-28.3c9.4-9.4 9.4-24.6.1-34zM208 336c-70.7 0-128-57.2-128-128 0-70.7 57.2-128 128-128 70.7 0 128 57.2 128 128 0 70.7-57.2 128-128 128z"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
  <div
    id="search-overlay"
    class="hidden relative z-40"
    aria-labelledby="slide-over-title"
    role="dialog"
    aria-modal="true"
  >
    <div
      id="search-backdrop"
      class="bg-rosely-granite/75 transition-opacity inset-x-0 bottom-0 top-16 fixed"
    >
    </div>

    <div class="inset-x-0 bottom-0 top-16 fixed overflow-hidden">
      <div class="inset-0 absolute overflow-hidden">
        <div class="pl-10 flex max-w-full pointer-events-none bottom-0 right-0 top-16 fixed">
          <div
            id="search-panel"
            class="max-w-md w-screen pointer-events-auto translate-x-full transition duration-500 ease-in-out relative sm:duration-700"
          >
            <div class="pr-2 pt-4 flex left-0 top-0 absolute -ml-8 sm:pr-4 sm:-ml-10">
              <button
                type="button"
                id="search-close"
                class="text-rosely-rose rounded-md hover:text-rosely-morning focus:outline-none focus:ring-2 focus:ring-white"
              >
                <span class="sr-only">Close panel</span>
                <div class="i-fa6-solid-xmark h-6 w-6"></div>
              </button>
            </div>

            <div
              class="py-6 bg-white flex flex-col h-full shadow-xl overflow-y-scroll dark:bg-rosely-black"
            >
              <div class="px-4 sm:px-6">
                <h2
                  class="text-lg text-rosely-black font-medium dark:text-rosely-sugar"
                  id="search-title"
                >
                  Search results
                </h2>
              </div>
              <div id="searchmodal" class="mt-6 px-4 flex-1 relative sm:px-6">
                <div
                  id="search-results"
                  class="rounded-lg ring-1 ring-rosely-black/5 shadow-lg overflow-hidden"
                >
                  <ul></ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</search-modal>

<script>
  import * as FlexSearch from 'flexsearch'

  interface SearchDoc {
    [key: string]: string | number | boolean | null | string[]
    url: string
    title: string
    description: string
    author: string | null
    pubDate: string | null
  }

  class SearchModal extends HTMLElement {
    private idx: FlexSearch.Document<SearchDoc> | null = null
    private doc: SearchDoc[] | null = null
    private initPromise: Promise<void> | null = null

    constructor() {
      super()
      const input = this.querySelector('#search-box') as HTMLInputElement
      const button = this.querySelector('#search-button') as HTMLButtonElement
      const overlay = this.querySelector('#search-overlay') as HTMLElement
      const panel = this.querySelector('#search-panel') as HTMLElement
      const closeBtn = this.querySelector('#search-close') as HTMLButtonElement
      const backdrop = this.querySelector('#search-backdrop') as HTMLElement

      const openModal = () => {
        previouslyFocused = document.activeElement as HTMLElement
        overlay.classList.remove('hidden')
        setTimeout(() => {
          panel.classList.remove('translate-x-full')
          panel.classList.add('translate-x-0')
          closeBtn.focus()
        }, 10)
      }

      const closeModal = () => {
        panel.classList.remove('translate-x-0')
        panel.classList.add('translate-x-full')
        setTimeout(() => {
          overlay.classList.add('hidden')
          previouslyFocused?.focus()
        }, 500)
      }

      let previouslyFocused: HTMLElement | null = null

      // Pre-load the search index when the user focuses on the input
      input.addEventListener('focus', () => {
        this.initSearch()
      })

      // Perform search dynamically as the user types
      input.addEventListener('input', () => {
        if (input.value.trim().length > 0) {
          openModal()
          this.performSearch(input.value)
        } else {
          closeModal()
          const resultsContainer = this.querySelector('#search-results ul') as HTMLElement
          const resultsTitle = this.querySelector('#search-title') as HTMLElement
          if (resultsContainer) resultsContainer.innerHTML = ''
          if (resultsTitle) resultsTitle.textContent = 'Search results'
        }
      })

      button.addEventListener('click', () => {
        if (input.value.trim().length > 0) {
          openModal()
          this.performSearch(input.value)
        }
      })

      input.addEventListener('keypress', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault()
          if (input.value.trim().length > 0) {
            openModal()
            this.performSearch(input.value)
          }
        }
      })

      closeBtn.addEventListener('click', closeModal)
      backdrop.addEventListener('click', closeModal)

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
          e.preventDefault()
          closeModal()
        }
      })
    }

    async initSearch() {
      if (this.initPromise) {
        return this.initPromise
      }
      this.initPromise = (async () => {
        if (!this.doc) {
          const res = await fetch(`${import.meta.env.BASE_URL}documents.json`)
          if (!res.ok) {
            console.error('Failed to load search index:', res.status)
            return
          }
          const data = (await res.json()) as unknown
          if (!Array.isArray(data)) {
            console.error('Search index has unexpected format')
            return
          }
          this.doc = data as SearchDoc[]
        }
        if (!this.idx && this.doc) {
          // Initialize a FlexSearch index on the client
          this.idx = new FlexSearch.Document({
            document: {
              id: 'url',
              index: [
                { field: 'title', tokenize: 'forward', resolution: 9 },
                { field: 'description', tokenize: 'forward', resolution: 5 },
                { field: 'author', tokenize: 'forward', resolution: 3 },
                { field: 'categories', tokenize: 'forward', resolution: 7 },
                { field: 'tags', tokenize: 'forward', resolution: 7 },
                { field: 'content', tokenize: 'forward', resolution: 1 }
              ],
              store: false
            }
          })

          // Build the index by adding all fetched documents
          this.doc.forEach((doc) => {
            this.idx!.add(doc)
          })
        }
      })()
      return this.initPromise
    }

    async performSearch(term: string) {
      const resultsTitle = this.querySelector('#search-title') as HTMLElement
      const resultsContainer = this.querySelector('#search-results ul') as HTMLElement

      if (!this.idx || !this.doc) {
        await this.initSearch()
      }

      if (!this.idx || !this.doc) return

      resultsContainer.innerHTML = ''
      if (term) {
        resultsTitle.textContent = `Search results for '${term}'`
        // FlexSearch search options
        const rawResults = this.idx!.search(term, { limit: 20 }) as {
          field: string
          result: string[]
        }[]

        // Flatten unique results from all indexed fields
        const results = [...new Set(rawResults.flatMap((r) => r.result))]

        if (results.length > 0) {
          results.forEach((url) => {
            const doc = this.doc?.find((d) => d.url === url)

            if (doc) {
              const li = document.createElement('li')
              li.className =
                '-m-3 p-3 flex items-start rounded-lg hover:bg-rosely-barely dark:hover:bg-rosely-grapeade'

              const metaParts = [
                doc.author,
                doc.pubDate
                  ? new Date(doc.pubDate).toLocaleDateString(undefined, {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric'
                    })
                  : ''
              ].filter(Boolean)

              const link = document.createElement('a')
              link.href = url

              const titleEl = document.createElement('p')
              titleEl.className = 'text-base font-bold text-rosely-black dark:text-rosely-sugar'
              titleEl.textContent = doc.title
              link.appendChild(titleEl)

              if (metaParts.length) {
                const metaEl = document.createElement('p')
                metaEl.className = 'mt-1 text-xs text-rosely-opal font-medium'
                metaEl.textContent = metaParts.join(' · ')
                link.appendChild(metaEl)
              }

              const descEl = document.createElement('p')
              descEl.className =
                'mt-1 text-sm text-rosely-granite font-medium dark:text-rosely-opal'
              descEl.textContent = doc.description
              link.appendChild(descEl)

              li.appendChild(link)
              resultsContainer.appendChild(li)
            }
          })
        } else {
          resultsContainer.innerHTML = '<li class="p-3">No results found...</li>'
        }
      }
    }
  }

  customElements.define('search-modal', SearchModal)
</script>
