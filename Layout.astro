---
import type { ImageMetadata } from 'astro'
import Metadata from './Metadata.astro'

export interface Props {
  title: string
  description: string
  date: Date
  image: ImageMetadata
  tags?: string[]
}

const { title, description, date, tags, image } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <Metadata title={title} description={description} date={date} image={image} tags={tags} />
    <style>
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body class="text-rosely-granite font-sans bg-rosely-sugar antialiased">
    <a
      href="#main-content"
      class="sr-only focus:text-white focus:px-4 focus:py-2 focus:outline-none focus:rounded focus:bg-rosely-orchid focus:left-4 focus:top-4 focus:fixed focus:z-50 focus:not-sr-only"
    >
      Skip to main content
    </a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
